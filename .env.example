# Environment template for the @pasympa/discord-mcp server (verified against 2.2.0).
#
# Copy this file to .env in the directory the MCP client spawns the server
# command from (the upstream server loads .env from its working directory
# automatically). Fill in values, then: chmod 600 .env
# The kit's .gitignore excludes .env so this file stays out of version control.
#
# IMPORTANT: every value below is an EMPTY PLACEHOLDER. The defaults documented
# by the upstream package apply to anything left blank. See the kit README for
# the full table and the hardening rationale.

# Required. The bot token from the Discord Developer Portal (Bot tab, Reset
# Token). Store only the raw value. If the token is ever exposed, reset it
# immediately in the portal.
DISCORD_TOKEN=

# Comma-separated toolsets to expose. Unset or empty exposes EVERY toolset
# (including dm and all destructive tools), which this kit never recommends.
# This kit's hardened baseline:
# DISCORD_MCP_TOOLSETS=discovery,messages
DISCORD_MCP_TOOLSETS=

# Comma-separated guild IDs the server may act on. Unset or empty allows every
# guild the bot can see. This kit treats an explicit allowlist as mandatory.
# Example: DISCORD_ALLOWED_GUILDS=123456789012345678
DISCORD_ALLOWED_GUILDS=

# Whether to request the Message Content privileged gateway intent at connect
# time. Upstream default: true. This kit pins false and keeps the portal
# toggle off.
# DISCORD_MESSAGE_CONTENT=false
DISCORD_MESSAGE_CONTENT=

# Whether to request the Server Members privileged gateway intent at connect
# time. Upstream default: true. This kit pins false and keeps the portal
# toggle off.
# DISCORD_GUILD_MEMBERS=false
DISCORD_GUILD_MEMBERS=